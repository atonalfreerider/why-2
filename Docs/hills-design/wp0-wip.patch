+namespace Why.Economy.Land
+{
+    /// <summary>
+    /// Highlight ids of the hills (SPEC2 10.4): 96,000-99,499, clear of the bowl's 80,000-95,000
+    /// (<see cref="EconomyIds"/>) and of the civilizations' 1,000,000+. Every block is contiguous, so a hill, a crown or a
+    /// stage of the mind is one id range. Players keep <see cref="EconomyIds.LandPlayer"/> (81,000 + 8p; part 6, spare in
+    /// the bowl, is the signals'); ties <see cref="EconomyIds.LandTie"/>, coalitions <see cref="EconomyIds.LandCoalition"/>,
+    /// roots <see cref="EconomyIds.LandRoot"/>, the cut <see cref="EconomyIds.LandCut"/>; lifelines and children keep
+    /// their lifeline ids.
+    /// </summary>
+    public static class HillIds
+    {
+        /// <summary>The first id of each block.</summary>
+        public const int HillBase = 96_000, BenchBase = 96_300, RiverBase = 96_400, GorgeBase = 96_450, VaporBase = 96_500,
+            CloudLevel = 96_560, TaxConduit = 96_570, TransferBase = 96_600, CrownBase = 96_700, CompanyBase = 96_900,
+            EstateBase = 97_000, GamesBase = 97_500, MindBase = 97_600, ParticleBase = 98_500;
+
+        /// <summary>Ids per hill and per crown.</summary>
+        public const int HillParts = 8, CrownParts = 8;
+
+        /// <summary>Parts of a hill's block.</summary>
+        public const int HillWages = 0, HillUpkeep = 1, HillCap = 2, HillContour = 3, HillLake = 4, HillRootsIn = 5,
+            HillCapital = 6, HillLabel = 7;
+
+        /// <summary>Parts of a crown's block.</summary>
+        public const int CrownBand = 0, CrownPoints = 1, CrownJewels = 2, CrownTethers = 3, CrownShadow = 4, CrownStem = 5,
+            CrownSeats = 6, CrownVapor = 7;
+
+        /// <summary>River lanes: 0-5 the spending categories, 6 imports.</summary>
+        public const int RiverImports = 6;
+
+        /// <summary>The limits of the counted blocks: transfers, estates, games' coalitions, mind items per stage, particles.</summary>
+        public const int TransferMax = 100, EstateMax = 500, GamesMax = 50, MindStageMax = 100, ParticleMax = 1_000;
+
+        /// <summary>One part of hill i (0 wages, 1 upkeep, 2 cap, 3 contour, 4 lake, 5 roots in, 6 capital river, 7 label).</summary>
+        public static int Hill(int i, int part) => HillBase + HillParts * i + part;
+
+        /// <summary>Every id of hill i.</summary>
+        public static IdRange HillBlock(int i) => new IdRange(Hill(i, 0), Hill(i, HillParts - 1));
+
+        /// <summary>Bench (tread) t.</summary>
+        public static int Bench(int t) => BenchBase + t;
+
+        /// <summary>Lane of tread t's river (0-5 categories, 6 imports).</summary>
+        public static int River(int t, int lane) => RiverBase + 8 * t + lane;
+
+        /// <summary>Gorge k.</summary>
+        public static int Gorge(int k) => GorgeBase + k;
+
+        /// <summary>The vapor rising from hill i.</summary>
+        public static int Vapor(int i) => VaporBase + i;
+
+        /// <summary>A transfer fountain (k &lt; 100).</summary>
+        public static int Transfer(int k) => TransferBase + k;
+
+        /// <summary>
+        /// One part of the crown over hill i (0 band, 1 points, 2 jewels, 3 tethers, 4 shadow, 5 stem, 6 named seats, 7 the
+        /// vapor through it).
+        /// </summary>
+        public static int Crown(int i, int part) => CrownBase + CrownParts * i + part;
+
+        /// <summary>Every id of the crown over hill i.</summary>
+        public static IdRange CrownBlock(int i) => new IdRange(Crown(i, 0), Crown(i, CrownParts - 1));
+
+        /// <summary>A capture company's mark (capture index).</summary>
+        public static int Company(int c) => CompanyBase + c;
+
+        /// <summary>An estate stream (k &lt; 500).</summary>
+        public static int Estate(int k) => EstateBase + k;
+
+        /// <summary>A coalition's games (c &lt; 50; part 0 the ladder, 1 the pyramid).</summary>
+        public static int Games(int c, int part) => GamesBase + 2 * c + part;
+
+        /// <summary>Item k of a stage of the mind (stage 0-7, k &lt; 100).</summary>
+        public static int Mind(int stage, int k) => MindBase + 100 * stage + k;
+
+        /// <summary>Every id of a stage of the mind.</summary>
+        public static IdRange MindStage(int stage) => new IdRange(Mind(stage, 0), Mind(stage, MindStageMax - 1));
+
+        /// <summary>A player's particle in the population mode (p &lt; 1,000).</summary>
+        public static int Particle(int p) => ParticleBase + p;
+    }
+}
