@@ -0,0 +1,219 @@
+using System;
+
+namespace Why.Economy.Model
+{
+    /// <summary>
+    /// One household-year of the program's trace (SPEC2 6.2): what each stage of the lives computed, quantized (about 90
+    /// bytes a row). Written by the lives where the values are computed (WP3), one row per household-year (both spouses'
+    /// slots point to it); read through <see cref="EconomicLives.TraceOf"/> by the program (ProgramModel) and the mind.
+    /// A default row (every field 0) is what the stub returns before WP3 fills the store.
+    /// </summary>
+    public struct TraceRow
+    {
+        /// <summary>Scales of the quantized fields: value = stored × scale.</summary>
+        public const float DriveScale = 1f / 250f, StressScale = 1f / 100f, BufferScale = 1f / 250f, SaveScale = 1e-4f,
+            TiltScale = 1e-3f, EquityScale = 1f / 250f, PlayFeedScale = 1e-3f;
+
+        /// <summary>The household's drives as used (desires food, collective, law, shelter, sex; × 250).</summary>
+        public byte D0, D1, D2, D3, D4;
+
+        /// <summary>The household's fears as used (starvation, isolation, murder, exposure, childless; × 250).</summary>
+        public byte F0, F1, F2, F3, F4;
+
+        /// <summary>Stress (mean of the adults, × 100: 0-2.55) and the thin-buffer pressure (× 250).</summary>
+        public byte Stress, Buffer;
+
+        /// <summary>The saving rate's parts: base, traits, age, kids (1e-4).</summary>
+        public short SaveBase, SaveTraits, SaveAge, SaveKids;
+
+        /// <summary>The 30 category tilt parts: [category × 5 + part] with parts trait, drive, children, age, interest (1e-3 log units).</summary>
+        public TraceTilts Tilt;
+
+        /// <summary>The equity share of financial assets (× 250).</summary>
+        public byte EquityShare;
+
+        /// <summary>The play feedback's factor on the drives (6.3b; 1e-3 log units).</summary>
+        public short PlayFeed;
+
+        /// <summary>The year's events (<see cref="TraceFlags"/>).</summary>
+        public ushort Flags;
+
+        /// <summary>Desire k (0..4) as used.</summary>
+        public float Desire(int k) => k switch { 0 => D0, 1 => D1, 2 => D2, 3 => D3, 4 => D4, _ => 0 } * DriveScale;
+
+        /// <summary>Fear k (0..4) as used.</summary>
+        public float Fear(int k) => k switch { 0 => F0, 1 => F1, 2 => F2, 3 => F3, 4 => F4, _ => 0 } * DriveScale;
+
+        /// <summary>A category's tilt part (log units).</summary>
+        public float TiltPart(int category, int part) => Tilt[category * 5 + part] * TiltScale;
+
+        /// <summary>Whether a flag is set.</summary>
+        public bool Has(TraceFlags flag) => (Flags & (ushort)flag) != 0;
+    }
+
+    /// <summary>The 30 category tilt parts of a <see cref="TraceRow"/> (6 categories × 5 parts), shorts at 1e-3 log units.</summary>
+    public struct TraceTilts
+    {
+        /// <summary>The parts in [category × 5 + part] order.</summary>
+            public short T00;
+            public short T01;
+            public short T02;
+            public short T03;
+            public short T04;
+            public short T05;
+            public short T06;
+            public short T07;
+            public short T08;
+            public short T09;
+            public short T10;
+            public short T11;
+            public short T12;
+            public short T13;
+            public short T14;
+            public short T15;
+            public short T16;
+            public short T17;
+            public short T18;
+            public short T19;
+            public short T20;
+            public short T21;
+            public short T22;
+            public short T23;
+            public short T24;
+            public short T25;
+            public short T26;
+            public short T27;
+            public short T28;
+            public short T29;
+
+        /// <summary>Part i (0..29); 0 out of range.</summary>
+        public short this[int i]
+        {
+            get
+            {
+                switch (i)
+                {
+                        case 0: return T00;
+                        case 1: return T01;
+                        case 2: return T02;
+                        case 3: return T03;
+                        case 4: return T04;
+                        case 5: return T05;
+                        case 6: return T06;
+                        case 7: return T07;
+                        case 8: return T08;
+                        case 9: return T09;
+                        case 10: return T10;
+                        case 11: return T11;
+                        case 12: return T12;
+                        case 13: return T13;
+                        case 14: return T14;
+                        case 15: return T15;
+                        case 16: return T16;
+                        case 17: return T17;
+                        case 18: return T18;
+                        case 19: return T19;
+                        case 20: return T20;
+                        case 21: return T21;
+                        case 22: return T22;
+                        case 23: return T23;
+                        case 24: return T24;
+                        case 25: return T25;
+                        case 26: return T26;
+                        case 27: return T27;
+                        case 28: return T28;
+                        case 29: return T29;
+                    default: return 0;
+                }
+            }
+            set
+            {
+                switch (i)
+                {
+                        case 0: T00 = value; break;
+                        case 1: T01 = value; break;
+                        case 2: T02 = value; break;
+                        case 3: T03 = value; break;
+                        case 4: T04 = value; break;
+                        case 5: T05 = value; break;
+                        case 6: T06 = value; break;
+                        case 7: T07 = value; break;
+                        case 8: T08 = value; break;
+                        case 9: T09 = value; break;
+                        case 10: T10 = value; break;
+                        case 11: T11 = value; break;
+                        case 12: T12 = value; break;
+                        case 13: T13 = value; break;
+                        case 14: T14 = value; break;
+                        case 15: T15 = value; break;
+                        case 16: T16 = value; break;
+                        case 17: T17 = value; break;
+                        case 18: T18 = value; break;
+                        case 19: T19 = value; break;
+                        case 20: T20 = value; break;
+                        case 21: T21 = value; break;
+                        case 22: T22 = value; break;
+                        case 23: T23 = value; break;
+                        case 24: T24 = value; break;
+                        case 25: T25 = value; break;
+                        case 26: T26 = value; break;
+                        case 27: T27 = value; break;
+                        case 28: T28 = value; break;
+                        case 29: T29 = value; break;
+                }
+            }
+        }
+    }
+
+    /// <summary>The events of a household-year in the trace (<see cref="TraceRow.Flags"/>).</summary>
+    [Flags]
+    public enum TraceFlags : ushort
+    {
+        None = 0, FloorBound = 1, Shock = 2, BoughtHome = 4, SoldHome = 8, Defaulted = 16, Dependent = 32,
+        ReceivedAllowance = 64, PaidAllowance = 128
+    }
+
+    /// <summary>
+    /// The program's trace store (SPEC2 6.2): one <see cref="TraceRow"/> per household-year and, per slot of the lives'
+    /// record (person × year), the index of its household's row. Empty until WP3 writes it (its rows are filled inside the
+    /// lives' existing Parallel.For bodies, each to its own row: deterministic). Read-only once the lives are ready.
+    /// </summary>
+    public sealed class ProgramTrace
+    {
+        /// <summary>The store before anything is traced: no rows.</summary>
+        public static readonly ProgramTrace Empty = new ProgramTrace(Array.Empty<TraceRow>(), Array.Empty<int>());
+
+        readonly TraceRow[] rows;
+        readonly int[] rowOfSlot;
+
+        /// <summary>A store over its rows and, per record slot, the row index (-1: none).</summary>
+        public ProgramTrace(TraceRow[] rows, int[] rowOfSlot)
+        {
+            this.rows = rows ?? Array.Empty<TraceRow>();
+            this.rowOfSlot = rowOfSlot ?? Array.Empty<int>();
+        }
+
+        /// <summary>Household-year rows.</summary>
+        public int Count => rows.Length;
+
+        /// <summary>Bytes held (rows and the slot index).</summary>
+        public long Bytes => rows.LongLength * 90 + rowOfSlot.LongLength * 4;
+
+        /// <summary>The row of a record slot (the lives' store index); false (a default row) when none.</summary>
+        public bool TryGet(int slot, out TraceRow row)
+        {
+            if (slot >= 0 && slot < rowOfSlot.Length)
+            {
+                int r = rowOfSlot[slot];
+                if (r >= 0 && r < rows.Length)
+                {
+                    row = rows[r];
+                    return true;
+                }
+            }
+
+            row = default;
+            return false;
+        }
+    }
+}
