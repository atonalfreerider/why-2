@@ -0,0 +1,66 @@
+namespace Why.Economy.Land
+{
+    /// <summary>A year change in playback (SPEC2 6.6): main thread; layers read it in Tick.</summary>
+    /// <remarks>
+    /// When the playback publishes year Y+1, <see cref="Begin"/> takes the two snapshots and the related players (each
+    /// next player's partner in the previous year and back, from ProgramModel.Related); for <see cref="Seconds"/> the
+    /// layers lerp what moves (the terrain's heights, glide markers from a related player's old position to its new one)
+    /// by <see cref="T"/>, then cross-fade to the new year. <c>LandViewLayer</c> ticks it every frame after the
+    /// playback clock. Outside playback it is idle (<see cref="Active"/> false, <see cref="T"/> 1).
+    /// </remarks>
+    public static class LandTween
+    {
+        /// <summary>The tween's length (s).</summary>
+        public const float Seconds = 0.8f;
+
+        /// <summary>The year the tween leaves and the year it arrives at (null before the first <see cref="Begin"/>).</summary>
+        public static LandSnapshot Prev { get; private set; }
+        public static LandSnapshot Next { get; private set; }
+
+        /// <summary>The tween's progress, eased (in-out cubic) 0 → 1.</summary>
+        public static float T { get; private set; } = 1f;               // eased (in-out cubic) 0 → 1
+
+        /// <summary>Whether a tween runs.</summary>
+        public static bool Active => Prev != null && T < 1f;
+
+        /// <summary>[next player] → prev player or −1.</summary>
+        public static int[] RelatedPrev { get; private set; }           // [next player] → prev player or −1
+
+        /// <summary>[prev player] → next player or −1.</summary>
+        public static int[] RelatedNext { get; private set; }           // [prev player] → next player or −1
+
+        /// <summary>The tween's clock (s since <see cref="Begin"/>).</summary>
+        static float clock;
+
+        /// <summary>
+        /// Starts a tween from one year's snapshot to the next with their related players (null: none related); restarts a
+        /// running one from its start.
+        /// </summary>
+        public static void Begin(LandSnapshot prev, LandSnapshot next, int[] relatedPrev, int[] relatedNext)
+        {
+            Prev = prev;
+            Next = next;
+            RelatedPrev = relatedPrev;
+            RelatedNext = relatedNext;
+            clock = 0;
+            T = prev != null ? 0f : 1f;
+        }
+
+        /// <summary>One frame (called by LandViewLayer after LandPlayback.Tick): the clock advances and T eases toward 1.</summary>
+        public static void Tick(float dt)
+        {
+            if (Prev == null || T >= 1f) return;
+            clock += dt > 0 ? dt : 0;
+            T = clock >= Seconds ? 1f : LandMath.EaseInOutCubic(clock / Seconds);
+        }
+
+        /// <summary>Back to idle (a new scene load, a stop): no snapshots held, T 1.</summary>
+        public static void Reset()
+        {
+            Prev = Next = null;
+            RelatedPrev = RelatedNext = null;
+            clock = 0;
+            T = 1f;
+        }
+    }
+}
