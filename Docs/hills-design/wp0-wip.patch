+        {
+            float a = 2 * Mathf.PI * (k + 0.5f) / Mathf.Max(1, n);
+            float rr = p.Radius + LandStyle.ChildRingGap;
+            Vector3 c = p.Pos;
+            return new Vector3(c.x + rr * Mathf.Cos(a), c.y + LandStyle.DotY0, c.z + rr * Mathf.Sin(a));
