+using System;
+using System.Collections.Generic;
+using UnityEngine;
+
+namespace Why.Economy.Land
+{
+    /// <summary>Points of the "must be in frame" items (SPEC2 10.2). Main thread; layers set, LandViewLayer logs.</summary>
+    /// <remarks>
+    /// Each land layer registers, at each build, the land-local points of its items under keys such as
+    /// <c>land:bench:2</c>, <c>land:crown:12</c> or <c>land:row:3:1</c> (a Core anchor holds one point, so the land
+    /// keeps its own list); with <c>WHY_DUMP_LAND=1</c> the land's view layer projects every item with the preset's
+    /// camera at each focus and logs "[Why] Frame &lt;preset&gt;: &lt;key&gt; in|out &lt;x0&gt; &lt;y0&gt; &lt;x1&gt; &lt;y1&gt;", which
+    /// the views' check reads. A layer clears its own keys (<see cref="ClearPrefix"/>) before it registers a rebuild.
+    /// </remarks>
+    public static class LandFrameItems
+    {
+        static readonly Dictionary<string, Vector3[]> items = new Dictionary<string, Vector3[]>(StringComparer.Ordinal);
+
+        /// <summary>Registers (or replaces) an item's land-local points; null or empty removes it.</summary>
+        public static void Set(string key, Vector3[] landLocalPoints)
+        {
+            if (string.IsNullOrEmpty(key)) return;
+            if (landLocalPoints == null || landLocalPoints.Length == 0) items.Remove(key);
+            else items[key] = landLocalPoints;
+        }
+
+        /// <summary>Removes every item whose key starts with the prefix (a layer clears its own keys before a rebuild).</summary>
+        public static void ClearPrefix(string prefix)
+        {
+            if (prefix == null) return;
+            List<string> gone = null;
+            foreach (string key in items.Keys)
+            {
+                if (!key.StartsWith(prefix, StringComparison.Ordinal)) continue;
+                (gone ??= new List<string>()).Add(key);
+            }
+
+            if (gone == null) return;
+            foreach (string key in gone) items.Remove(key);
+        }
+
+        /// <summary>Every registered item: key → land-local points.</summary>
+        public static IReadOnlyDictionary<string, Vector3[]> All => items;
+    }
+}
