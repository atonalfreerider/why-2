+using UnityEngine;
+
+namespace Why.Economy.Land
+{
+    // The contract types of the hill landscape (SPEC2 11.2, frozen once WP0 merges): the land's frame, the terrain and
+    // its height field, the year's money per player without geometry, the drawn flows, and the glyph's points. Builders
+    // (HillLayout, TerrainField, MoneyAccounts, HillFlows; WP1) fill them on a worker; the land layers only read them.
+    // Dollars are $B nominal of the year; positions are land-local (LandFrame: +x right seen from the road, +y up, +z
+    // away from the road).
+
+    /// <summary>The land's fixed frame (SPEC2 2.1). Land-local: x ∈ [−7, 7], z ∈ [−Depth/2, Depth/2], +z away from the road.</summary>
+    public static class HillFrame
+    {
+        /// <summary>The land's width and depth, the margin at each side and the gap between hill feet (u).</summary>
+        public const float Width = 14f, Depth = 15.15f, Edge = 0.30f, Gap = 0.22f;
+
+        /// <summary>The benches' heights: gov, raw, make, services, tech.</summary>
+        public static readonly float[] BenchY = { 0f, 0.70f, 1.40f, 2.10f, 2.80f };
+
+        /// <summary>
+        /// The depth budget (in d): the gov tread, the mesa zone, each riser and tread, the four hill zones together, the
+        /// least zone, the back margin.
+        /// </summary>
+        public const float Front = 1.20f, GovZone = 1.00f, Riser = 0.70f, Tread = 1.20f, DZones = 5.00f, ZMin = 0.70f, Back = 0.35f;
+
+        /// <summary>The cloud level, and the crown band's bottom and highest top (y).</summary>
+        public const float CloudY = 4.50f, CrownBase = 3.55f, CrownTopMax = 4.20f;
+
+        /// <summary>The river's centre, from the tread's lip.</summary>
+        public const float RoadV = 0.60f;                                          // the river's centre, from the tread's lip
+
+        /// <summary>Floor rows 0-3, from the tread's lip (band 0 nearest the hills, band 3 at the lip).</summary>
+        public static readonly float[] BandV = { 1.07f, 0.87f, 0.33f, 0.13f };     // floor rows 0-3, from the lip
+
+        /// <summary>Slope rows 0-3: elevation fractions of their hill.</summary>
+        public static readonly float[] SlopeE = { 0.10f, 0.32f, 0.50f, 0.68f };    // slope rows: elevation fractions
+
+        /// <summary>A disc's radius per √(people / 1M); a stock's radius per √($ / GDP).</summary>
+        public const float DiscK = 0.030f, StockK = 0.75f;                          // r = DiscK √(people/1M); r = StockK √($/GDP)
+
+        /// <summary>
+        /// Scales per GDP of the year: hill area, lake area, the lakes' largest half-depth, money flow width, capital and
+        /// root width.
+        /// </summary>
