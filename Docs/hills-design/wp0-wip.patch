+using System;
+using System.Collections.Generic;
+using UnityEngine;
+
+namespace Why.Humans.Smv
+{
+    /// <summary>
+    /// Turns on "bonds" in the population graph (SPEC2 8): married couples run close to the mid-plane, every child born
+    /// from <see cref="FromYear"/> on starts where its mother's and father's lines meet on the mid-plane, immigrants enter
+    /// from the outer edge of their side. Published under <see cref="SmvPopulation.BondsKey"/> by a layer that prepares
+    /// before <see cref="SmvLayer"/> (the economy scene's loader); without it the lines are exactly the causality graph's.
+    /// The defaults are the economy's (8.3).
+    /// </summary>
+    public sealed class SmvBondsOptions
+    {
+        /// <summary>Births before this calendar year keep the original drawing (off the economy's road).</summary>
+        public double FromYear = 1946;
+
+        /// <summary>Married offsets are scaled by this, eased in over CoupleRampIn after the wedding and out over CoupleRampOut after the end.</summary>
+        public float CoupleSqueeze = 0.5f;
+
+        public double CoupleRampIn = 1.0, CoupleRampOut = 1.0;
+
+        /// <summary>A parent's line bends into the meeting point over these years before and after a birth (married parents and mothers).</summary>
+        public double BendBefore = 1.5, BendAfter = 1.0;
+
+        /// <summary>The same for a father not married to the mother: a shorter reach.</summary>
+        public double BriefBefore = 0.75, BriefAfter = 0.5;
+
+        /// <summary>Two births of one parent at most this many years apart: the parent's line stays on the mid-plane between them.</summary>
+        public double BridgeYears = 2.5;
+
+        /// <summary>The newborn's line leaves the meeting point toward the children's core with this time constant (years).</summary>
+        public double ChildDescentTau = 0.8;
+
+        /// <summary>Immigrants' lines start at the outer edge of their side (× envelope) and glide in with this time constant (years).</summary>
+        public float ArrivalEdge = 1.0f;
+
+        public double ArrivalTau = 0.5;
+
+        /// <summary>Lines glow where they bond: the parents' bends (× (1 + gain × pull)) and the newborn's first years.</summary>
+        public float GlowGain = 2.0f, GlowAlpha = 1.2f;
+
+        public double NewbornGlowYears = 1.0;
+
+        /// <summary>The births' beads and the wedding ties.</summary>
+        public Color KnotColor = new Color(0.70f, 0.80f, 1f);
+
+        public Color TieColor = new Color(0.62f, 0.72f, 1f);
+    }
+
+    /// <summary>A birth's parents: a married couple, an unmarried father, or the mother alone.</summary>
+    public enum SmvBirthKind : byte { Married, Unmarried, MotherOnly }
+
+    /// <summary>One birth at the mid-plane.</summary>
+    public struct SmvBirth
+    {
+        /// <summary>The child, its mother and its father (-1 when the simulation found none).</summary>
+        public int Child, Mother, Father;
+
+        /// <summary>The simulation step of the birth.</summary>
+        public int Step;
+
+        /// <summary>The meeting height (data space): the mean of the parents' heights at the step.</summary>
+        public float Y;
+
+        /// <summary>Who the parents are.</summary>
+        public SmvBirthKind Kind;
+    }
+
+    /// <summary>
+    /// The bonds pass (SPEC2 8.3): runs once on a finished <see cref="SmvSimulation"/> (worker thread, after the line
+    /// style's model) and rewrites its samples, so everything that reads them agrees. WP0 stub: <see cref="Apply"/>
+    /// changes nothing and <see cref="FamilyIds"/> adds the person's own lifeline only; WP4 implements both.
+    /// </summary>
+    public sealed class SmvBonds
+    {
+        /// <summary>The options it ran with.</summary>
+        public readonly SmvBondsOptions Options;
+
+        /// <summary>Every birth at the mid-plane (from FromYear on), in child order.</summary>
+        public readonly List<SmvBirth> Births = new List<SmvBirth>();
+
+        /// <summary>Per person: the birth they are the child of (index into <see cref="Births"/>), or -1.</summary>
+        public int[] BirthOf = Array.Empty<int>();
+
+        /// <summary>Per person: the births they take part in as a parent (indices into <see cref="Births"/>).</summary>
+        public int[][] BirthsAsParent = Array.Empty<int[]>();
+
+        /// <summary>The featured family's marriage (the couples view; -1 none).</summary>
+        public int Featured = -1;
+
+        /// <summary>Per sample (indexed like the simulation's samples): how strongly the line is bonding there (0..255).</summary>
+        public byte[] Glow = Array.Empty<byte>();
+
+        /// <summary>Σ (y × 1000 + ρ) of the samples in index order.</summary>
+        public double Checksum;
+
+        readonly SmvSimulation sim;
+
+        public SmvBonds(SmvSimulation sim, SmvBondsOptions options)
+        {
+            this.sim = sim;
+            Options = options ?? new SmvBondsOptions();
+        }
+
+        /// <summary>The bonds pass (the stub: nothing changes).</summary>
+        public void Apply()
+        {
+            int n = sim?.People.Count ?? 0;
+            BirthOf = new int[n];
+            for (int i = 0; i < n; i++) BirthOf[i] = -1;
+            BirthsAsParent = new int[n][];
+            for (int i = 0; i < n; i++) BirthsAsParent[i] = Array.Empty<int>();
+        }
+
+        /// <summary>The body of the "[Why] SmvBonds" log line.</summary>
+        public string Summary() => "(demo) no bonds: " + Births.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) + " births";
+
+        /// <summary>
+        /// The highlight ranges of a person's family on the graph (the person, spouses, parents, children; ≤ 16 ranges),
+        /// what the inspector hands to the highlighter. The stub: the person's own lifeline only.
+        /// </summary>
+        public static void FamilyIds(SmvPopulation pop, int person, List<IdRange> into)
+        {
+            if (pop?.Sim == null || into == null || person < 0 || person >= pop.Sim.People.Count) return;
+            into.Add(IdRange.Single(pop.Id(pop.Sim.People[person])));
+        }
+    }
+}
