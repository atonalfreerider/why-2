+using System;
+using System.Collections.Generic;
+
+namespace Why.Economy.Land
+{
+    /// <summary>The season on screen, for the UI (SPEC2 5.0). Main thread. SeasonLayer sets it; the bowl's SocialLayer keeps its own.</summary>
+    /// <remarks>
+    /// The bowl's <c>SocialLayer</c> held the season on screen for the panels (<c>SocialLayer.Shown</c>,
+    /// <c>SocialLayer.CoalitionsAt</c>); it is retired with the bowl, so the hills' <c>SeasonLayer</c> publishes its
+    /// season here at each swap (the default, the betrayal or the viewer's incident season) and with null on destroy.
+    /// The UI reads <c>LandSeason.Shown ?? SocialLayer.Shown</c>, so the bowl's branch keeps working.
+    /// </remarks>
+    public static class LandSeason
+    {
+        /// <summary>The season on screen; null before the land (or while no season layer shows one).</summary>
+        public static SocialSeasonResult Shown { get; private set; }
+
+        /// <summary>Sets the season on screen (main thread; SeasonLayer at each swap, null on destroy).</summary>
+        public static void SetShown(SocialSeasonResult season) => Shown = season;
+
+        /// <summary>The number of coalitions of a season at the detection a round shows (the panel's readout).</summary>
+        public static int CoalitionsAt(SocialSeasonResult s, int round)
+        {
+            if (s?.CoalitionAt == null || s.CoalitionAt.Length == 0) return 0;
+            int[] labels = s.CoalitionAt[Detection(round, s.CoalitionAt.Length)];
+            HashSet<int> ids = new HashSet<int>();
+            foreach (int c in labels)
+            {
+                if (c >= 0) ids.Add(c);
+            }
+
+            return ids.Count;
+        }
+
+        /// <summary>The detection a round shows: the last one at or before it (rounds 0, 24, 48, 72, 96).</summary>
+        static int Detection(int round, int count)
+        {
+            int[] at = LandStyle.Detections;
+            int d = 0;
+            for (int i = 0; i < Math.Min(count, at.Length); i++)
+            {
+                if (round >= at[i]) d = i;
+            }
+
+            return d;
+        }
+    }
+}
