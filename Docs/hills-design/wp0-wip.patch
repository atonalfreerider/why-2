+        /// <summary>
+        /// Land-local position of a member's dot (3.8): slot k of n of the sunflower at Pos (radius 0.85 r √((k + 0.5) / n),
+        /// angle 2.39996 k from the land's +x axis), at 0.03 + 0.25 × reason above the disc.
+        /// </summary>
+        public static Vector3 DotSlot(Player p, int k, int n, float reason)
+        {
+            float rr = LandStyle.DotSpread * p.Radius * Mathf.Sqrt((k + 0.5f) / Mathf.Max(1, n));
+            float a = LandStyle.GoldenAngle * k;
+            Vector3 c = p.Pos;
+            return new Vector3(c.x + rr * Mathf.Cos(a), c.y + LandStyle.DotY0 + LandStyle.DotYReason * Mathf.Clamp01(reason),
+                c.z + rr * Mathf.Sin(a));
+        }
+
+        /// <summary>Land-local position of a child's dot: slot k of n on the ring at r + 0.02 around Pos, at the disc's height.</summary>
